{
  "name": "react-shaders",
  "version": "0.0.6",
  "description": "React Shaders is an open source library for creating GLSL/WebGL shaders in React and Typescript, with support for modern shader bindings like those in Shadertoy and Rysana.",
  "homepage": "https://rysana.com/docs/react-shaders",
  "repository": {
    "type": "git",
    "url": "https://github.com/rysanacom/react-shaders"
  },
  "license": "MIT",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist/**/*", "README.md", "package.json"],
  "scripts": {
    "build": "tsup",
    "build:tsc": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "clean": "rm -rf dist",
    "check": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "devDependencies": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8",
    "typescript": "^5.4.5"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.0.0",
    "react-dom": "^18.3.1 || ^19.0.0"
  }
}
